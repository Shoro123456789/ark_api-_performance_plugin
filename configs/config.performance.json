  "CVars": {
    "Enabled": true,
    "ReapplyMinutes": 30,
    "List": [
      {
        "Command": "a.URO.Enable 1",
        "Enabled": true,
        "Note": "Animation update-rate optimisation"
      },
      {
        "Command": "a.ParallelAnimUpdate 1",
        "Enabled": true,
        "Note": "Animation update on worker threads"
      },
      {
        "Command": "a.ParallelAnimEvaluation 1",
        "Enabled": true,
        "Note": "Animation evaluation on worker threads"
      },
      {
        "Command": "a.ParallelAnimInterpolation 1",
        "Enabled": true,
        "Note": "Animation interpolation on worker threads"
      },
      {
        "Command": "a.URO.ForceAnimRate 4",
        "Enabled": true,
        "Note": "AGGRESSIVE: server animates every 4th frame. Disable first if hits on moving dinos feel off"
      },
      {
        "Command": "net.UseAdaptiveNetUpdateFrequency 1",
        "Enabled": true,
        "Note": "Replicate idle actors less often"
      },
      {
        "Command": "tick.AllowAsyncTickDispatch 1",
        "Enabled": true,
        "Note": "Dispatch tick tasks from worker threads"
      },
      {
        "Command": "tick.AllowAsyncTickCleanup 1",
        "Enabled": true,
        "Note": "Clean up tick tasks on worker threads"
      },
      {
        "Command": "tick.AllowConcurrentTickQueue 1",
        "Enabled": true,
        "Note": "Queue ticks concurrently"
      },
      {
        "Command": "gc.AllowIncrementalReachability 1",
        "Enabled": true,
        "Note": "Spread GC marking over frames (turn PerformaceGC AutoGC/GCCVars off)"
      },
      {
        "Command": "gc.IncrementalReachabilityTimeLimit 0.005",
        "Enabled": true,
        "Note": "5 ms GC budget per frame"
      },
      {
        "Command": "gc.AllowIncrementalGather 1",
        "Enabled": true,
        "Note": "Spread GC gather over frames"
      },
      {
        "Command": "gc.MultithreadedDestructionEnabled 1",
        "Enabled": true,
        "Note": "Destroy objects on worker threads"
      },
      {
        "Command": "s.ForceGCAfterLevelStreamedOut 0",
        "Enabled": true,
        "Note": "No forced GC each time an area unloads (uses more RAM)"
      },
      {
        "Command": "s.ContinuouslyIncrementalGCWhileLevelsPendingPurge 0",
        "Enabled": true,
        "Note": "No extra GC passes while areas unload"
      }
    ]
  },
